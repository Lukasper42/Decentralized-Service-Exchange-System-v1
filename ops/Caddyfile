{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    @relay path /v1/*
    handle @relay {
        reverse_proxy relay:3000
    }

    @static path / /styles.css
    @static_js {
        path_regexp dist_js ^/dist/.+\.js$
        not path /dist/tests/*
    }

    handle @static {
        root * /srv
        header {
            Cache-Control "no-store"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            Cross-Origin-Opener-Policy "same-origin"
            Cross-Origin-Resource-Policy "same-origin"
            Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https: http://*.onion http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
        }
        file_server
    }

    handle @static_js {
        root * /srv
        header {
            Cache-Control "no-store"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            Cross-Origin-Opener-Policy "same-origin"
            Cross-Origin-Resource-Policy "same-origin"
            Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https: http://*.onion http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
        }
        file_server
    }

    handle {
        respond 404
    }
}

mailbox.{$DOMAIN} {
    reverse_proxy 127.0.0.1:8787
}
