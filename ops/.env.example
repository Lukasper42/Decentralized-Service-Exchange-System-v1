# Public DNS name for the relay and web UI.
DOMAIN=example.com

# ACME account email used by Caddy.
ACME_EMAIL=admin@example.com

# PostgreSQL password (use URL-safe characters; write a literal $ as $$).
POSTGRES_PASSWORD=change-me

# SHA-256 of ops/secrets/genesis.json (sha256sum ops/secrets/genesis.json).
GENESIS_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Relay rate limits.
RATE_PER_IP=120
RATE_PER_KEY=60

# Backup retention count per backup kind.
BACKUP_KEEP=14

# Optional GPG recipient for encrypting the secrets backup; leave empty to disable encryption.
BACKUP_GPG_RECIPIENT=
