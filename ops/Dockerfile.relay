FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY skill-exchange-ledger/package.json skill-exchange-ledger/package-lock.json ./
RUN npm ci

COPY skill-exchange-ledger/ ./
RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production

WORKDIR /app

COPY skill-exchange-ledger/package.json skill-exchange-ledger/package-lock.json ./
RUN npm ci --omit=dev

COPY --from=build /app/dist ./dist

USER node

CMD ["node", "dist/apps/relay/main.js"]
