FROM node:22-bookworm-slim AS build

WORKDIR /src

COPY skillx-web/package.json skillx-web/package-lock.json ./
RUN npm ci

COPY skillx-web/ ./
RUN npx tsc -p tsconfig.json

RUN mkdir -p /srv \
    && cp index.html styles.css /srv/ \
    && cp -a dist /srv/ \
    && rm -rf /srv/dist/tests

FROM caddy:2

COPY --from=build /srv /srv
COPY ops/Caddyfile /etc/caddy/Caddyfile
