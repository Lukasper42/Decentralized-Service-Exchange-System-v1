PORT=3000
HOST=127.0.0.1
# memory | postgres
RELAY_MODE=memory
DATABASE_URL=postgres://skill:skill@localhost:5432/skill_exchange
# Pinned genesis: the relay refuses to start if the file's SHA-256 differs.
GENESIS_FILE=./genesis.json
GENESIS_SHA256=
# Optional directory with policy documents named <params_hash>.json
POLICY_DIR=
# Base64 PKCS8 Ed25519 key, file mode 0600, outside the repository.
RELAY_KEY_FILE=/etc/skill-exchange/relay.key
MAX_BODY_BYTES=65536
MAX_EVENT_BYTES=4096
CHECKPOINT_EVERY=100
RATE_PER_IP=120
RATE_PER_KEY=60
RATE_WINDOW_MS=60000
MAX_PAGE=500
ALLOWED_ORIGIN=
# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed. Required behind a proxy,
# otherwise every client shares the proxy's rate-limit budget.
TRUSTED_PROXIES=
# Off-ledger circular-trading report receiver (POST /v1/reports). Leave all three empty to keep the route disabled (404).
# JSON array of {"pubkey","valid_from_sequence","valid_to_sequence"}; set together with REPORT_OUTBOX_FILE.
LISTENER_ALLOWLIST_FILE=
# NDJSON file for accepted reports (durable); finding ids and a .done marker file next to it survive restarts.
REPORT_OUTBOX_FILE=
# Optional http(s) endpoint that receives every stored report (at-least-once, replayed after a restart).
REPORT_DELIVERY_URL=
