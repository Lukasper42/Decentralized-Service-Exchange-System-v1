{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/relay/**/*.ts": {
      "maxDuration": 60
    },
    "api/mailbox/**/*.ts": {
      "maxDuration": 30
    },
    "api/relay-router.ts": {
      "maxDuration": 60
    },
    "api/mailbox-router.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https: http://*.onion http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://skillx-web-six.vercel.app"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://skillx-web-six.vercel.app"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://skillx-web-six.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/relay/:path*",
      "destination": "/api/relay-router?__route=:path*"
    },
    {
      "source": "/api/mailbox/:path*",
      "destination": "/api/mailbox-router?__route=:path*"
    }
  ]
}
